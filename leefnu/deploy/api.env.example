# /etc/leefnu/api.env  (root:leefnu, 640)  —  VOORBEELD, zonder geheimen.
# Echte waarden alleen op de server invullen. Nooit committen, nooit in chat.

NODE_ENV=production
PORT=8787
LEEFNU_DB=/var/lib/leefnu/niveaus.sqlite

# Mollie live-sleutel (begint met live_). Een test_-sleutel wordt in productie geweigerd.
MOLLIE_API_KEY=

# Ed25519-privésleutel voor niveau-tokens, één regel base64 (PKCS#8 DER).
# Maken met: node scripts/maak-sleutels.js  — de bijbehorende publieke sleutel
# gaat in leefnu/src/lib/config.js als TOKEN_PUBLIC_KEY.
LEEFNU_TOKEN_PRIVATE_KEY=
